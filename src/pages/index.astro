---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SAMPLE_GROUPS, DEFAULT_SAMPLE_SLUG, getAllSamples } from '../data/samples';

const wasmDir = path.join(process.cwd(), 'public', 'wasm');

function isAvailable(target: string): boolean {
  try {
    return fs.existsSync(path.join(wasmDir, `${target}.html`));
  } catch {
    return false;
  }
}

const catalog = SAMPLE_GROUPS.flatMap(g =>
  g.samples.map(s => ({
    ...s,
    group: g.id,
    groupLabel: g.label,
    available: isAvailable(s.target),
  }))
);

const groupsWithMeta = SAMPLE_GROUPS.map(g => ({
  ...g,
  count: g.samples.length,
  availableCount: g.samples.filter(s => isAvailable(s.target)).length,
}));

const orderedSlugs = getAllSamples().map(s => s.slug);
const catalogJSON = JSON.stringify(catalog);
const orderedJSON = JSON.stringify(orderedSlugs);
const availableCount = catalog.filter(s => s.available).length;
---

<BaseLayout>
  <div class="shell">

    <!-- ── Left panel ─────────────────────────────────────────────── -->
    <nav class="panel" id="panel" aria-label="Sample catalog">

      <div class="panel-head">
        <a href="/" class="brand" aria-label="VertexNova home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="22" height="22" fill="none">
              <defs>
                <linearGradient id="vnBrand" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#FDBA74"/>
                  <stop offset="100%" stop-color="#F97316"/>
                </linearGradient>
              </defs>
              <circle cx="16" cy="16" r="14" stroke="url(#vnBrand)" stroke-width="2"/>
              <path d="M16 7 L24 16 L16 25 L8 16 Z" fill="url(#vnBrand)" opacity="0.9"/>
            </svg>
          </span>
          <span class="brand-text">
            <span class="brand-name">VertexNova</span>
            <span class="brand-sub">WebGPU Samples</span>
          </span>
        </a>
        <div class="panel-meta">
          <span class="meta-count">{availableCount}/{catalog.length} live</span>
          <span class="dot">·</span>
          <a href="/support">Support</a>
          <span class="dot">·</span>
          <a href="https://github.com/vertexnova/vnerhi" target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </div>

      <div class="search-wrap">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          id="searchInput"
          type="search"
          placeholder="Filter samples…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Filter samples"
        />
        <kbd class="search-kbd" title="Press / to focus">/</kbd>
      </div>

      <div class="sample-list" id="sampleList">
        {groupsWithMeta.map(group => (
          <div class="group" data-group={group.id}>
            <div class="group-label">
              <span>{group.label}</span>
              <span class="group-count">{group.availableCount}/{group.count}</span>
            </div>
            <ul>
              {group.samples.map(s => {
                const available = isAvailable(s.target);
                return (
                  <li>
                    <a
                      href={`#${s.slug}`}
                      class:list={['sample-link', { soon: !available }]}
                      data-slug={s.slug}
                      data-target={s.target}
                      data-available={available ? '1' : '0'}
                    >
                      <span class="sample-num">{s.number}</span>
                      <span class="sample-title">{s.title}</span>
                      {!available && <span class="soon-badge">Soon</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
        <p class="no-results" id="noResults" hidden>No matches.</p>
      </div>

      <button class="panel-close" id="panelClose" aria-label="Close catalog">✕</button>
    </nav>

    <!-- ── Main ───────────────────────────────────────────────────── -->
    <div class="main" id="main">

      <div class="topbar">
        <button class="menu-btn" id="menuBtn" aria-label="Open sample list">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <rect y="2" width="16" height="1.5" rx="0.75"/>
            <rect y="7.25" width="16" height="1.5" rx="0.75"/>
            <rect y="12.5" width="16" height="1.5" rx="0.75"/>
          </svg>
        </button>
        <span id="topbarName" class="topbar-name"></span>
      </div>

      <div class="sample-view" id="sampleView">
        <div class="frame-area" id="frameArea">
          <!-- iframe is created per sample click -->

          <div class="overlay" id="overlayLoading">
            <div class="spinner" aria-hidden="true"></div>
            <span>Loading…</span>
          </div>

          <div class="overlay unavail" id="overlayUnavail" hidden>
            <span class="warn" aria-hidden="true">◇</span>
            <p>Coming soon</p>
            <p class="hint">This sample is in the curriculum but not yet built for WebGPU. Re-run the Build WebGPU Samples workflow after updating vnerhi.</p>
          </div>

          <div class="overlay unavail" id="overlayBlocked" hidden>
            <span class="warn" aria-hidden="true">⚠</span>
            <p id="blockedTitle">Cannot run this sample</p>
            <p class="hint" id="blockedHint"></p>
            <div class="overlay-actions">
              <button type="button" class="btn-retry" id="retryBtn">Retry</button>
              <a href="/support">Browser support</a>
            </div>
          </div>

          <div class="overlay unavail" id="overlaySlow" hidden>
            <span class="warn" aria-hidden="true">…</span>
            <p>Taking longer than expected</p>
            <p class="hint">The sample may still be downloading WASM, or it failed silently.</p>
            <div class="overlay-actions">
              <button type="button" class="btn-retry" id="reloadSampleBtn">Reload sample</button>
            </div>
          </div>

          <button type="button" class="exit-fs-btn" id="exitFsBtn" hidden title="Exit fullscreen (Esc)">
            Exit fullscreen
            <kbd>Esc</kbd>
          </button>

          <div class="info-card" id="infoBar">
            <div class="info-text">
              <div class="info-heading">
                <span class="info-group" id="infoGroup"></span>
                <span class="info-num" id="infoNum"></span>
              </div>
              <h2 class="info-title" id="infoTitle"></h2>
              <p class="info-desc" id="infoDesc"></p>
            </div>
            <div class="info-tools">
              <div class="nav-arrows" aria-label="Curriculum navigation">
                <button type="button" class="icon-btn" id="prevBtn" title="Previous sample (←)" aria-label="Previous sample">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button type="button" class="icon-btn" id="nextBtn" title="Next sample (→)" aria-label="Next sample">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path d="M9 18l6-6-6-6"/></svg>
                </button>
              </div>
              <nav class="info-links" aria-label="Sample links">
                <a id="srcLink" href="#" target="_blank" rel="noopener" class="icon-btn text" title="Source">Source</a>
                <a id="standaloneLink" href="#" target="_blank" rel="noopener" class="icon-btn text" title="Open standalone">Standalone</a>
                <button type="button" class="icon-btn text" id="fullscreenBtn" title="Enter fullscreen (F)" aria-pressed="false">Fullscreen</button>
                <a id="reportLink" href="#" target="_blank" rel="noopener" class="icon-btn text" title="Report a bug">Report</a>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="backdrop" id="backdrop"></div>
  </div>
</BaseLayout>

<style>
/* ── Shell ──────────────────────────────────────────────────────── */
.shell {
  display: flex;
  height: 100vh;
  height: 100dvh;
  overflow: hidden;
}

/* ── Panel ──────────────────────────────────────────────────────── */
.panel {
  width: 300px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: var(--panel);
  backdrop-filter: blur(18px) saturate(1.2);
  -webkit-backdrop-filter: blur(18px) saturate(1.2);
  border-right: 1px solid var(--border-soft);
  overflow: hidden;
  box-shadow: 8px 0 40px rgba(0, 0, 0, 0.35);
}

.panel-head {
  padding: 1.1rem 1.1rem 0.85rem;
  border-bottom: 1px solid var(--border-soft);
  flex-shrink: 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  color: inherit;
  text-decoration: none;
  margin-bottom: 0.55rem;
}
.brand:hover { color: inherit; }
.brand-mark {
  display: flex;
  flex-shrink: 0;
  filter: drop-shadow(0 0 10px var(--orange-glow));
}
.brand-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 1px;
}
.brand-name {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  background: var(--gradient-brand);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  line-height: 1.15;
}
.brand-sub {
  font-size: 0.72rem;
  color: var(--muted);
  font-weight: 500;
  letter-spacing: 0.01em;
}

.panel-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  font-size: 0.7rem;
  color: var(--muted-dim);
  font-family: var(--font-mono);
}
.panel-meta a { color: var(--muted); }
.panel-meta a:hover { color: var(--orange-light); }
.meta-count { color: var(--orange-light); }
.dot { color: var(--border); }

/* Search */
.search-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0.65rem 0.85rem;
  padding: 0.45rem 0.7rem;
  background: var(--panel-mid);
  border: 1px solid var(--border);
  border-radius: 999px;
  flex-shrink: 0;
  transition: border-color 0.15s, box-shadow 0.15s;
}
.search-wrap:focus-within {
  border-color: var(--orange);
  box-shadow: 0 0 0 3px var(--orange-tint);
}
.search-icon { color: var(--muted); flex-shrink: 0; }
#searchInput {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  font-family: var(--font-sans);
  font-size: 0.84rem;
  color: var(--text);
  min-width: 0;
}
#searchInput::placeholder { color: var(--muted-dim); }
.search-kbd {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--muted-dim);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 1px 5px;
  background: var(--panel-solid);
}

/* Sample list */
.sample-list {
  flex: 1;
  overflow-y: auto;
  padding: 0.25rem 0 1.25rem;
  overscroll-behavior: contain;
}
.sample-list::-webkit-scrollbar { width: 4px; }
.sample-list::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 2px;
}

.group { margin-bottom: 0.15rem; }
.group[hidden] { display: none; }

.group-label {
  position: sticky;
  top: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  font-family: var(--font-display);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--orange-light);
  padding: 0.7rem 1.1rem 0.35rem;
  background: linear-gradient(180deg, rgba(18, 18, 24, 0.96) 60%, transparent);
}
.group-count {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 500;
  letter-spacing: 0;
  text-transform: none;
  color: var(--muted-dim);
}

.group ul { list-style: none; padding: 0; margin: 0; }

.sample-link {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.38rem 1.1rem;
  font-family: var(--font-sans);
  font-size: 0.86rem;
  color: #B4B4BE;
  text-decoration: none;
  border-left: 2px solid transparent;
  transition: color 0.12s, background 0.12s, border-color 0.12s, box-shadow 0.12s;
  min-width: 0;
}
.sample-link:hover {
  color: var(--text);
  background: var(--panel-hover);
}
.sample-link.active {
  color: var(--orange-light);
  border-left-color: var(--orange);
  background: var(--orange-tint);
  box-shadow: inset 3px 0 12px rgba(249, 115, 22, 0.12);
  font-weight: 500;
}
.sample-link.soon {
  opacity: 0.55;
}
.sample-link.soon:hover { opacity: 0.8; }

.sample-num {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 500;
  color: var(--muted-dim);
  min-width: 1.5rem;
  letter-spacing: 0.02em;
}
.sample-link.active .sample-num { color: var(--orange); }
.sample-title {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.soon-badge {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 0.58rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--muted-dim);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 0.1rem 0.4rem;
}

.no-results {
  font-size: 0.78rem;
  color: var(--muted);
  padding: 0.75rem 1.1rem;
  margin: 0;
}

.panel-close { display: none; }

/* ── Main ───────────────────────────────────────────────────────── */
.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-width: 0;
  background:
    radial-gradient(ellipse 70% 50% at 50% 0%, rgba(249, 115, 22, 0.06), transparent 60%),
    var(--bg-elevated);
}

.topbar {
  display: none;
  align-items: center;
  gap: 0.75rem;
  height: 48px;
  padding: 0 1rem;
  border-bottom: 1px solid var(--border-soft);
  background: var(--panel);
  backdrop-filter: blur(12px);
  flex-shrink: 0;
}
.menu-btn {
  background: transparent;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--muted);
  padding: 6px 9px;
  cursor: pointer;
  display: flex;
  align-items: center;
}
.menu-btn:hover { border-color: var(--orange); color: var(--orange-light); }
.topbar-name {
  font-family: var(--font-display);
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sample-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 0;
}

.frame-area {
  flex: 1;
  position: relative;
  min-height: 0;
  background: #050508;
}

.frame-area :global(iframe) {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: none;
  display: block;
  background: transparent;
}

/* Floating info card */
.info-card {
  position: absolute;
  left: 1rem;
  right: 1rem;
  bottom: 1rem;
  z-index: 5;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem 1.5rem;
  padding: 0.95rem 1.15rem;
  background: rgba(12, 12, 18, 0.78);
  backdrop-filter: blur(16px) saturate(1.3);
  -webkit-backdrop-filter: blur(16px) saturate(1.3);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius);
  box-shadow:
    0 12px 40px rgba(0, 0, 0, 0.45),
    0 0 0 1px rgba(249, 115, 22, 0.06);
  pointer-events: auto;
  max-width: min(920px, calc(100% - 2rem));
  margin: 0 auto;
}
.info-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.info-heading {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}
.info-group {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-mono);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--orange-light);
  background: var(--orange-tint);
  border: 1px solid rgba(249, 115, 22, 0.25);
  border-radius: 999px;
  padding: 0.18rem 0.55rem;
  line-height: 1.2;
}
.info-num {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--muted-dim);
}
.info-title {
  margin: 0;
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.03em;
  line-height: 1.15;
}
.info-desc {
  margin: 0;
  max-width: 48rem;
  font-size: 0.82rem;
  color: var(--muted);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.info-tools {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.45rem;
  flex-shrink: 0;
}
.nav-arrows {
  display: flex;
  gap: 0.3rem;
}
.icon-btn {
  appearance: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.25rem;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--muted);
  text-decoration: none;
  background: transparent;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.35rem 0.5rem;
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s, background 0.15s;
}
.icon-btn:hover:not(:disabled) {
  color: var(--orange-light);
  border-color: var(--orange);
  background: var(--orange-tint);
}
.icon-btn:disabled {
  opacity: 0.35;
  cursor: default;
}
.icon-btn.text { padding: 0.32rem 0.55rem; }
.info-links {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

/* Overlays */
.overlay {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.65rem;
  background: rgba(5, 5, 8, 0.92);
  font-family: var(--font-sans);
  font-size: 0.88rem;
  color: var(--muted);
  text-align: center;
  padding: 2rem;
}
.overlay[hidden] { display: none; }
.spinner {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: conic-gradient(from 0deg, transparent, var(--orange), var(--orange-light), transparent);
  mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
  animation: spin 0.85s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.warn {
  font-size: 1.5rem;
  color: var(--orange);
  filter: drop-shadow(0 0 12px var(--orange-glow));
}
.overlay p { margin: 0; line-height: 1.55; max-width: 28rem; color: var(--text); font-weight: 500; }
.overlay .hint {
  font-size: 0.78rem !important;
  font-weight: 400 !important;
  color: var(--muted) !important;
  margin-top: 0.1rem !important;
}
.overlay a { color: var(--orange-light); }
.overlay-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-top: 0.5rem;
  flex-wrap: wrap;
  justify-content: center;
}
.btn-retry {
  appearance: none;
  font-family: var(--font-display);
  font-size: 0.82rem;
  font-weight: 600;
  color: #fff;
  background: var(--gradient-brand);
  border: none;
  border-radius: var(--radius-sm);
  padding: 0.5rem 1.1rem;
  cursor: pointer;
  box-shadow: 0 4px 18px var(--orange-glow);
}
.btn-retry:hover { filter: brightness(1.08); }

.exit-fs-btn {
  position: absolute;
  top: 1rem;
  right: 1rem;
  z-index: 30;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  appearance: none;
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text);
  background: rgba(12, 12, 18, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.45rem 0.75rem;
  cursor: pointer;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.45);
}
.exit-fs-btn[hidden] { display: none; }
.exit-fs-btn:hover {
  border-color: var(--orange);
  color: var(--orange-light);
  background: rgba(249, 115, 22, 0.12);
}
.exit-fs-btn kbd {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 500;
  color: var(--muted);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 1px 5px;
  background: var(--panel-solid);
}

.backdrop {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 39;
  background: rgba(0, 0, 0, 0.65);
}
.backdrop.visible { display: block; }

@media (max-width: 700px) {
  .panel {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 40;
    width: min(300px, 88vw);
    transform: translateX(-100%);
    transition: transform 0.22s ease;
    box-shadow: 6px 0 32px rgba(0, 0, 0, 0.5);
  }
  .panel.open { transform: translateX(0); }

  .panel-close {
    display: block;
    position: absolute;
    top: 0.85rem;
    right: 0.75rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--muted);
    font-size: 0.75rem;
    padding: 3px 7px;
    cursor: pointer;
    z-index: 1;
  }

  .topbar { display: flex; }

  .info-card {
    left: 0.65rem;
    right: 0.65rem;
    bottom: 0.65rem;
    flex-direction: column;
    align-items: stretch;
    padding: 0.8rem 0.9rem;
    gap: 0.7rem;
  }
  .info-tools { align-items: stretch; }
  .nav-arrows { justify-content: flex-start; }
  .info-links { justify-content: flex-start; }
  .info-desc { -webkit-line-clamp: 3; }
  .search-kbd { display: none; }
}
</style>

<script is:inline define:vars={{ catalogJSON, orderedJSON, DEFAULT_SAMPLE_SLUG }}>
const catalog = JSON.parse(catalogJSON);
const orderedSlugs = JSON.parse(orderedJSON);

const panel          = document.getElementById('panel');
const backdrop       = document.getElementById('backdrop');
const panelClose     = document.getElementById('panelClose');
const menuBtn        = document.getElementById('menuBtn');
const frameArea      = document.getElementById('frameArea');
const overlayLoading = document.getElementById('overlayLoading');
const overlayUnavail = document.getElementById('overlayUnavail');
const overlayBlocked = document.getElementById('overlayBlocked');
const overlaySlow    = document.getElementById('overlaySlow');
const blockedTitle   = document.getElementById('blockedTitle');
const blockedHint    = document.getElementById('blockedHint');
const infoTitle      = document.getElementById('infoTitle');
const infoDesc       = document.getElementById('infoDesc');
const infoGroup      = document.getElementById('infoGroup');
const infoNum        = document.getElementById('infoNum');
const srcLink        = document.getElementById('srcLink');
const standaloneLink = document.getElementById('standaloneLink');
const reportLink     = document.getElementById('reportLink');
const topbarName     = document.getElementById('topbarName');
const searchInput    = document.getElementById('searchInput');
const noResults      = document.getElementById('noResults');
const retryBtn       = document.getElementById('retryBtn');
const reloadSampleBtn = document.getElementById('reloadSampleBtn');
const prevBtn        = document.getElementById('prevBtn');
const nextBtn        = document.getElementById('nextBtn');
const fullscreenBtn  = document.getElementById('fullscreenBtn');
const exitFsBtn      = document.getElementById('exitFsBtn');
const loadingLabel   = document.querySelector('#overlayLoading span');

const LOAD_TIMEOUT_MS = 20000;
const hasWebGPU = typeof navigator !== 'undefined' && !!navigator.gpu;

let currentSlug = null;
let currentFrame = null;
let loadTimer = null;
let loadGeneration = 0;

function openPanel()  {
  panel.classList.add('open');
  backdrop.classList.add('visible');
  document.body.style.overflow = 'hidden';
}
function closePanel() {
  panel.classList.remove('open');
  backdrop.classList.remove('visible');
  document.body.style.overflow = '';
}
menuBtn?.addEventListener('click', openPanel);
panelClose?.addEventListener('click', closePanel);
backdrop?.addEventListener('click', closePanel);

searchInput?.addEventListener('input', () => {
  const q = searchInput.value.trim().toLowerCase();
  let any = false;
  document.querySelectorAll('.group').forEach(g => {
    let groupVisible = false;
    g.querySelectorAll('.sample-link').forEach(a => {
      const match = !q || a.textContent.toLowerCase().includes(q);
      a.parentElement.hidden = !match;
      if (match) groupVisible = true;
    });
    g.hidden = !groupVisible;
    if (groupVisible) any = true;
  });
  noResults.hidden = any;
});

document.addEventListener('keydown', (e) => {
  if (e.key === '/' && document.activeElement !== searchInput) {
    const tag = document.activeElement && document.activeElement.tagName;
    if (tag !== 'INPUT' && tag !== 'TEXTAREA') {
      e.preventDefault();
      searchInput?.focus();
      searchInput?.select();
    }
    return;
  }
  if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
  if (e.key === 'f' || e.key === 'F') {
    e.preventDefault();
    toggleFullscreen();
    return;
  }
  if (e.key === 'ArrowLeft') {
    e.preventDefault();
    navigateRelative(-1);
  } else if (e.key === 'ArrowRight') {
    e.preventDefault();
    navigateRelative(1);
  }
});

function showBlocked(title, hint) {
  overlayLoading.hidden = true;
  overlayUnavail.hidden = true;
  if (overlaySlow) overlaySlow.hidden = true;
  if (overlayBlocked) overlayBlocked.hidden = false;
  if (blockedTitle) blockedTitle.textContent = title;
  if (blockedHint) blockedHint.textContent = hint;
}

function hideOverlays() {
  overlayLoading.hidden = true;
  overlayUnavail.hidden = true;
  if (overlayBlocked) overlayBlocked.hidden = true;
  if (overlaySlow) overlaySlow.hidden = true;
}

function destroyFrame() {
  if (loadTimer) {
    clearTimeout(loadTimer);
    loadTimer = null;
  }
  if (currentFrame) {
    currentFrame.removeAttribute('src');
    currentFrame.remove();
    currentFrame = null;
  }
}

function createFrame(wasmUrl, generation) {
  destroyFrame();
  const iframe = document.createElement('iframe');
  iframe.title = 'WebGPU Sample';
  iframe.setAttribute('allow', 'cross-origin-isolated');
  iframe.src = wasmUrl;
  frameArea.insertBefore(iframe, frameArea.firstChild);
  currentFrame = iframe;

  loadTimer = setTimeout(() => {
    if (generation !== loadGeneration) return;
    if (!overlayLoading.hidden) {
      overlayLoading.hidden = true;
      if (overlaySlow) overlaySlow.hidden = false;
    }
  }, LOAD_TIMEOUT_MS);

  return iframe;
}

function updateNavButtons(slug) {
  const idx = orderedSlugs.indexOf(slug);
  if (prevBtn) prevBtn.disabled = idx <= 0;
  if (nextBtn) nextBtn.disabled = idx < 0 || idx >= orderedSlugs.length - 1;
}

function navigateRelative(delta) {
  const idx = orderedSlugs.indexOf(currentSlug || DEFAULT_SAMPLE_SLUG);
  const next = orderedSlugs[idx + delta];
  if (next) loadSample(next);
}

function loadSample(slug, force = false) {
  const s = catalog.find(x => x.slug === slug);
  if (!s) return;
  if (!force && currentSlug === slug && currentFrame) return;
  currentSlug = slug;
  loadGeneration += 1;
  const generation = loadGeneration;

  if (window.location.hash !== '#' + slug) {
    history.pushState(null, '', '#' + slug);
  }

  document.querySelectorAll('.sample-link').forEach(el => {
    el.classList.toggle('active', el.dataset.slug === slug);
  });

  infoTitle.textContent = s.title;
  if (infoDesc) infoDesc.textContent = s.description;
  if (infoGroup) {
    infoGroup.textContent = s.groupLabel || '';
    infoGroup.hidden = !s.groupLabel;
  }
  if (infoNum) infoNum.textContent = s.number ? '#' + s.number : '';
  topbarName.textContent = (s.number ? s.number + ' · ' : '') + s.title;
  updateNavButtons(slug);

  const wasmUrl = '/wasm/' + s.target + '.html';
  standaloneLink.href = s.available ? wasmUrl : '#';
  standaloneLink.toggleAttribute('aria-disabled', !s.available);
  srcLink.href = 'https://github.com/vertexnova/vnerhi/tree/main/samples/' + s.target;

  const issueUrl = new URL('https://github.com/vertexnova/vertexnova.github.io/issues/new');
  issueUrl.searchParams.set('template', 'webgpu-sample-bug.yml');
  issueUrl.searchParams.set('title', '[WebGPU] ' + s.title);
  reportLink.href = issueUrl.toString();

  destroyFrame();
  hideOverlays();
  overlayLoading.hidden = false;
  if (loadingLabel) loadingLabel.textContent = 'Loading…';

  if (!s.available) {
    overlayLoading.hidden = true;
    overlayUnavail.hidden = false;
    closePanel();
    return;
  }

  if (!hasWebGPU) {
    showBlocked(
      'WebGPU is required',
      'Use Chrome/Edge 113+, Safari 18+, or Chrome for Android 121+ on a Vulkan device.'
    );
    closePanel();
    return;
  }

  if (!window.crossOriginIsolated) {
    if (loadingLabel) loadingLabel.textContent = 'Enabling cross-origin isolation…';
    // Isolation is fixed for a document's lifetime. Offer Retry after a short wait
    // so the head service worker has a chance to reload the page.
    setTimeout(() => {
      if (generation !== loadGeneration) return;
      if (window.crossOriginIsolated) {
        loadSample(slug, true);
        return;
      }
      showBlocked(
        'Could not enable cross-origin isolation',
        'This sample needs SharedArrayBuffer. Allow service workers, then click Retry. Private/strict browsers may block this.'
      );
    }, 2500);
    closePanel();
    return;
  }

  createFrame(wasmUrl, generation);
  closePanel();
}

window.addEventListener('message', (event) => {
  if (currentFrame && event.source !== currentFrame.contentWindow) return;
  const data = event.data;
  if (!data || data.source !== 'vnerhi-sample') return;
  if (data.type === 'ready') {
    if (loadTimer) { clearTimeout(loadTimer); loadTimer = null; }
    hideOverlays();
  } else if (data.type === 'error') {
    if (loadTimer) { clearTimeout(loadTimer); loadTimer = null; }
    showBlocked('Sample failed to start', String(data.detail || 'Unknown error'));
  }
});

retryBtn?.addEventListener('click', () => {
  window.sessionStorage.removeItem('coiReloadAttempts');
  window.sessionStorage.removeItem('coiCoepHasFailed');
  window.sessionStorage.removeItem('coiReloadedBySelf');
  location.reload();
});

reloadSampleBtn?.addEventListener('click', () => {
  if (currentSlug) loadSample(currentSlug, true);
});

prevBtn?.addEventListener('click', () => navigateRelative(-1));
nextBtn?.addEventListener('click', () => navigateRelative(1));

function syncFullscreenUI() {
  const active = !!document.fullscreenElement;
  if (fullscreenBtn) {
    fullscreenBtn.textContent = active ? 'Exit fullscreen' : 'Fullscreen';
    fullscreenBtn.title = active ? 'Exit fullscreen (Esc / F)' : 'Enter fullscreen (F)';
    fullscreenBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
  }
  if (exitFsBtn) exitFsBtn.hidden = !active;
}

function toggleFullscreen() {
  const el = frameArea;
  if (!el) return;
  if (document.fullscreenElement) {
    document.exitFullscreen?.().catch(() => {});
  } else {
    el.requestFullscreen?.().catch(() => {});
  }
}

fullscreenBtn?.addEventListener('click', toggleFullscreen);
exitFsBtn?.addEventListener('click', () => {
  document.exitFullscreen?.().catch(() => {});
});
document.addEventListener('fullscreenchange', syncFullscreenUI);
syncFullscreenUI();

document.querySelectorAll('.sample-link').forEach(el => {
  el.addEventListener('click', e => {
    e.preventDefault();
    loadSample(el.dataset.slug);
  });
});

function handleHash() {
  const slug = location.hash.slice(1) || DEFAULT_SAMPLE_SLUG;
  const s = catalog.find(x => x.slug === slug);
  if (s) loadSample(slug);
}
window.addEventListener('popstate', handleHash);
handleHash();
</script>
